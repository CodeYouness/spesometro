{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run alembic current *)",
      "Bash(uv run alembic history *)",
      "Bash(uv run alembic check *)",
      "Bash(pre-commit run *)",
      "Bash(railway status *)",
      "Bash(railway logs *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh secret list *)",
      "mcp__context7__*",
      "mcp__supabase__*"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv run alembic upgrade *)",
      "Bash(uv run alembic downgrade *)",
      "Bash(railway up *)",
      "Bash(railway redeploy *)",
      "Bash(railway variables *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(gh secret set *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.spesometro-backup.key)",
      "Bash(cat .env *)",
      "Bash(rm -rf *)"
    ]
  }
}
