# Spesometro — variabili d'ambiente (SPEC §7–§8).
# Copiare in `.env` (ignorato da git) e compilare. Nessun valore reale in questo file.
# In produzione le stesse variabili vanno nelle Variables di Railway e nei Secrets di GitHub Actions.

# --- LLM / AI -----------------------------------------------------------------
# Chiave Anthropic: estrazione scontrini con Claude Haiku 5.5 (default vision).
ANTHROPIC_API_KEY=
# Chiave Mistral pay-as-you-go (opt-out training attivo, mai tier gratuito): matching, chat, OCR 4.1.
MISTRAL_API_KEY=
# Chiave OpenAI: solo embedding `text-embedding-3-small` per il matching su pgvector.
OPENAI_API_KEY=
# Provider vision per l'estrazione: `anthropic` (default) oppure `mistral` (EU-only).
VISION_PROVIDER=anthropic
# Chiave OpenRouter: solo per la colonna Qwen dell'eval (data_collection=deny, zdr=true); vuota in produzione.
OPENROUTER_API_KEY=

# --- Supabase (regione EU) ----------------------------------------------------
# URL del progetto Supabase (API REST, Auth, Storage).
SUPABASE_URL=https://<project-ref>.supabase.co
# Chiave pubblicabile (sb_publishable_...): client lato utente, soggetta a RLS.
SUPABASE_PUBLISHABLE_KEY=
# Chiave segreta (sb_secret_...): solo server/worker (Storage, cancellazione account); mai nel browser.
SUPABASE_SECRET_KEY=
# Postgres via SESSION POOLER porta 5432 per tutto (app, Alembic, pg_dump, checkpointer LangGraph, Actions); mai 6543, mai direct (IPv6-only su Free). Password percent-encoded.
# Host esatto dal pannello Connect → Session pooler: il prefisso aws-N varia (es. aws-1-eu-central-1)
DATABASE_URL=postgresql://postgres.<project-ref>:<password-percent-encoded>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Endpoint JWKS per verificare in FastAPI i JWT asimmetrici emessi da Supabase Auth.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Web app / Railway ----------------------------------------------------------
# Porta HTTP; Railway la inietta da sé, in locale si usa questo valore (anche per `/health`).
PORT=8000
# NiceGUI 4.0 solleva ValueError con più worker: sempre 1 (1 replica, nessuna sticky session).
WEB_CONCURRENCY=1
# Segreto per firmare `app.storage.user` di NiceGUI (`storage_secret`); stringa casuale lunga.
NICEGUI_STORAGE_SECRET=
# Token Railway: solo per CLI/CI (`railway up`); vuoto se il deploy parte dall'integrazione GitHub.
RAILWAY_TOKEN=

# --- Osservabilità: LangSmith EU ------------------------------------------------
# Attiva il tracing LangChain/LangGraph.
LANGSMITH_TRACING=true
# Endpoint API della regione EU (UI su eu.smith.langchain.com).
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Chiave API LangSmith (piano Developer).
LANGSMITH_API_KEY=
# Nome del progetto in cui finiscono le tracce.
LANGSMITH_PROJECT=spesometro
# Nasconde gli input delle tracce (immagini, testo scontrini).
LANGSMITH_HIDE_INPUTS=true
# Nasconde gli output delle tracce (il JSON estratto può contenere un codice fiscale).
LANGSMITH_HIDE_OUTPUTS=true

# --- Telegram (bot S4 + alert) --------------------------------------------------
# Token del bot da BotFather.
TELEGRAM_BOT_TOKEN=
# `secret_token` del webhook, verificato su ogni richiesta in arrivo.
TELEGRAM_WEBHOOK_SECRET=
# Chat che riceve gli alert (budget 80%, job fallito 3 volte).
TELEGRAM_ALERT_CHAT_ID=

# --- Backup: Cloudflare R2 (usato dal workflow GitHub Actions) ------------------
# Account ID Cloudflare che ospita il bucket.
R2_ACCOUNT_ID=
# Access key ID del token API R2 con permesso di scrittura sul solo bucket di backup.
R2_ACCESS_KEY_ID=
# Secret access key dello stesso token R2.
R2_SECRET_ACCESS_KEY=
# Nome del bucket dei backup cifrati.
R2_BUCKET=spesometro-backups
# Endpoint S3-compatibile di R2 (per la giurisdizione EU: <account-id>.eu.r2.cloudflarestorage.com).
R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# Chiave pubblica `age` (age1...) per cifrare i dump; la chiave privata resta offline, mai qui.
BACKUP_AGE_RECIPIENT=

# Utente demo (creato a mano in Supabase Auth; credenziali solo nel password manager e nel README a dicembre)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_ID=
